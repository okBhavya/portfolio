# Public canonical URL used for Open Graph metadata, sitemap.xml, and robots.txt.
# Update this to your custom domain once deployed (e.g. https://bhavyagupta.dev).
NEXT_PUBLIC_SITE_URL=https://bhavyagupta.dev

# Optional configurable availability flag ("building" | "seeking")
# Keep "building" unless actively seeking roles.
NEXT_PUBLIC_AVAILABILITY_MODE=building
