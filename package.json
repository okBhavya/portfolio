    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=vmThreads"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.80.0",
