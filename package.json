{
  "name": "bhavya-gupta-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive personal portfolio and engineering laboratory for Bhavya Gupta",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "node -e \"process.env.ANALYZE='true'; require('child_process').execSync('npx next build', {stdio:'inherit'})\"",
